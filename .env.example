RDP_MONSTER_API_TOKEN=rdpm_your_token_here
RDP_MONSTER_BASE_URL=https://dashboard.rdp.monster/api/v1

# Retail price = list price x this multiplier, rounded up to .99
RETAIL_MULTIPLIER=1.7

# 32+ random characters. Encrypts server credentials at rest. Rotating it
# makes existing stored passwords unreadable.
APP_SECRET=change_me_to_a_long_random_string

# Signing secret from the RDP Monster client area webhook settings.
RDPM_WEBHOOK_SECRET=

# Fulfilment is inert until a reviewed release flips the deployment config.
PROVISIONING_ENABLED=false

# Cash buffer kept above the next order's supplier cost. Set to roughly one
# month of renewals; checkout fails closed when the live balance is lower.
SUPPLIER_RESERVE_CENTS=0

# Public Turnstile site key (safe to expose). Both Turnstile values must be set
# together; with the secret present, checkout requires a valid widget token.
# The secret is a Worker secret: set it in Cloudflare, never in source or chat.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Zeno Bank (crypto). Checkout stays disabled until a verified gateway is wired;
# these names are placeholders only. Never commit real values.
ZENO_API_KEY=
ZENO_WEBHOOK_SECRET=
ZENO_BASE_URL=https://api.zenobank.io
