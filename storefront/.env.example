RDP_MONSTER_API_TOKEN=rdpm_your_token_here
RDP_MONSTER_BASE_URL=https://dashboard.rdp.monster/api/v1

# Retail price = list price x this multiplier, rounded up to .99
RETAIL_MULTIPLIER=1.7

# 32+ random characters. Encrypts server credentials at rest. Rotating it
# makes existing stored passwords unreadable.
APP_SECRET=change_me_to_a_long_random_string

# Stripe is optional for local UI development. Missing payment configuration
# fails closed in production. This example is not a real merchant connection.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signing secret from the RDP Monster client area webhook settings.
RDPM_WEBHOOK_SECRET=

PUBLIC_BASE_URL=http://localhost:3000

# Never enable these on the internet or in Cloudflare staging.
ALLOW_DEV_CHECKOUT=false
PROVISIONING_ENABLED=false
